APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=rs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

KANCELARKO_URL=https://kancelarko.local
CRM_URL="${APP_URL}"
KEY_MODULE_ENCRYPT=
LEGACY_MODULE=MODULE_CRM
LEGACY_MODULE_LABEL=CRM
LEGACY_LOGIN_FORM=true
APP_DEFAULT_MODUL=Delovodnik

OFFICE_HOST=127.0.0.1
OFFICE_PORT=3306
OFFICE_DATABASE=office_master
OFFICE_USERNAME=root
OFFICE_PASSWORD=

SRV_1_HOST=127.0.0.1
SRV_1_PORT=3306
SRV_1_DATABASE=office_licenca
SRV_1_USERNAME=root
SRV_1_PASSWORD=

ORGAPISERVER=http://orgapi.paragraf.rs/
ORGAPISERVERTOKEN=
LEGACY_ORGAPI_ENABLED=true
LEGACY_CRM_PACKAGE_NAME=CRM

LEGACY_DEV_MODULES=
LEGACY_AUTO_CREATE_DB_ACCOUNT=true
